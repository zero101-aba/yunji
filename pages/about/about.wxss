.about-page {
  min-height: 100vh;
  padding: 18rpx 26rpx 70rpx;
  background: #F7F5F0;
}

.about-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 26rpx 0 12rpx;
}

.app-logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  box-shadow: 0 12rpx 30rpx rgba(62, 52, 38, 0.08);
}

.app-name {
  margin-top: 18rpx;
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.app-desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #9C958A;
}

.version-chip {
  margin-top: 14rpx;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: #E8F1EC;
  color: #2F6F5E;
  font-size: 21rpx;
}

.created {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #B3ABA0;
}

.stat-grid {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-top: 22rpx;
  padding: 22rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(62, 52, 38, 0.04);
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid #F3EEE6;
}

.stat-cell:last-child {
  border-right: none;
}

.stat-val {
  font-size: 32rpx;
  font-weight: 600;
  color: #2E2A25;
}

.stat-val.small-num {
  font-size: 22rpx;
  line-height: 1.6;
}

.stat-cap {
  margin-top: 4rpx;
  font-size: 19rpx;
  color: #A59D91;
}

.step-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 6rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(62, 52, 38, 0.04);
}

.step-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3EEE6;
}

.step-row:last-child {
  border-bottom: none;
}

.step-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #F6F1E8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

.step-main {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.step-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #2E2A25;
}

.step-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.65;
  color: #9C958A;
}

.note-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 6rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(62, 52, 38, 0.04);
}

.note-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3EEE6;
}

.note-row:last-child {
  border-bottom: none;
}

.note-title {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  color: #4A453E;
}

.note-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #9C958A;
}

.menu-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 0 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(62, 52, 38, 0.04);
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F3EEE6;
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-title {
  font-size: 27rpx;
  color: #2E2A25;
}

.menu-arrow {
  color: #C4BDB1;
  font-size: 26rpx;
}

.feedback-card {
  margin-top: 28rpx;
  background: #FFFDF9;
  border: 1rpx solid #EDE7DD;
  border-radius: 22rpx;
  padding: 26rpx;
}

.fb-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #4A453E;
}

.fb-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #9C958A;
}

.fb-btn {
  margin-top: 18rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
}

.footer {
  text-align: center;
  font-size: 20rpx;
  color: #B3ABA0;
  padding: 34rpx 0 10rpx;
}
