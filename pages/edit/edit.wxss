.edit-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 60rpx;
  background: #F7F5F0;
}

.edit-type {
  display: flex;
  margin-bottom: 18rpx;
}

.edit-type .chip {
  height: 64rpx;
  padding: 0 30rpx;
  font-size: 26rpx;
  margin-right: 12rpx;
}

.amount-card {
  background: #FFFFFF;
  border-radius: 26rpx;
  padding: 24rpx 30rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(62, 52, 38, 0.04);
}

.amount-cap {
  font-size: 23rpx;
  color: #8C857B;
}

.amount-input-row {
  display: flex;
  align-items: baseline;
  margin-top: 4rpx;
}

.amount-symbol {
  font-size: 36rpx;
  font-weight: 600;
  margin-right: 10rpx;
}

.amount-input {
  flex: 1;
  font-size: 66rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
}

.form-card {
  background: #FFFFFF;
  border-radius: 26rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(62, 52, 38, 0.04);
}

.note-card {
  position: relative;
  background: #FFFFFF;
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(62, 52, 38, 0.04);
}

.edit-note {
  width: 100%;
  height: 130rpx;
  font-size: 27rpx;
  line-height: 1.6;
}

.note-count {
  text-align: right;
  font-size: 21rpx;
  color: #B3ABA0;
}

.img-row {
  display: flex;
  flex-wrap: wrap;
}

.img-item {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.img-thumb {
  width: 100%;
  height: 100%;
}

.img-del {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  width: 38rpx;
  height: 38rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(30, 26, 20, 0.68);
  color: #FFFFFF;
  font-size: 26rpx;
}

.img-add {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  border: 1rpx dashed #D8D0C3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #A59D91;
  background: #FAF7F1;
}

.img-plus {
  font-size: 40rpx;
  line-height: 1;
}

.img-text {
  font-size: 22rpx;
  margin-top: 8rpx;
}

.edit-actions {
  margin-top: 40rpx;
}

.delete-btn {
  margin-top: 20rpx;
}

.empty-btn {
  margin-top: 20rpx;
  width: 240rpx;
  height: 76rpx;
  line-height: 76rpx;
}
