.accounts-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 70rpx;
  background: #F7F5F0;
}

.assets-card {
  background: linear-gradient(140deg, #2F6F5E 0%, #3B816C 100%);
  border-radius: 30rpx;
  padding: 30rpx 32rpx;
  color: #FFFFFF;
  display: flex;
  flex-direction: column;
  box-shadow: 0 16rpx 34rpx rgba(47, 111, 94, 0.18);
}

.assets-cap {
  font-size: 23rpx;
  opacity: 0.75;
}

.assets-val {
  font-size: 62rpx;
  font-weight: 600;
  letter-spacing: -0.03em;
  margin-top: 6rpx;
}

.assets-note {
  font-size: 21rpx;
  opacity: 0.65;
  margin-top: 12rpx;
}

.account-list {
  background: #FFFFFF;
  border-radius: 26rpx;
  padding: 0 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(62, 52, 38, 0.04);
}

.account-card {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F3EEE6;
}

.account-card:last-child {
  border-bottom: none;
}

.ac-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: #F3EFE7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.ac-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.ac-name-row {
  display: flex;
  align-items: center;
}

.ac-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #2E2A25;
}

.ac-type {
  font-size: 19rpx;
  color: #9C9489;
  background: #F4F0E8;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
}

.ac-extra {
  display: block;
  font-size: 21rpx;
  color: #A59D91;
  margin-top: 4rpx;
}

.ac-right {
  display: flex;
  align-items: center;
}

.ac-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: #2E2A25;
}

.ac-amount.neg {
  color: #DE6B47;
}

.ac-arrow {
  color: #C4BDB1;
  margin-left: 10rpx;
  font-size: 26rpx;
}

.add-btn {
  margin-top: 24rpx;
}

.tip-card {
  margin-top: 26rpx;
  padding: 24rpx 26rpx;
  background: #FFFDF9;
  border: 1rpx solid #EDE7DD;
  border-radius: 20rpx;
}

.tip-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #4A453E;
}

.tip-desc {
  display: block;
  font-size: 21rpx;
  line-height: 1.7;
  color: #9C9489;
  margin-top: 6rpx;
}
