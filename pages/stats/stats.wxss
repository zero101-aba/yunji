.stats-page {
  min-height: 100vh;
  padding: 8rpx 28rpx 60rpx;
  background: #F7F5F0;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0 22rpx;
}

.period-nav {
  display: flex;
  align-items: center;
}

.p-arrow {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #EFEAE2;
  color: #5A544B;
  font-size: 36rpx;
}

.p-label {
  font-size: 32rpx;
  font-weight: 600;
  margin: 0 16rpx;
  min-width: 170rpx;
  text-align: center;
}

.period-seg {
  width: 190rpx;
}

.period-seg .seg-item {
  padding: 8rpx 0;
  font-size: 24rpx;
}

.hero {
  background: linear-gradient(140deg, #2F6F5E 0%, #3B816C 100%);
  border-radius: 30rpx;
  padding: 28rpx 32rpx;
  color: #FFFFFF;
  box-shadow: 0 16rpx 34rpx rgba(47, 111, 94, 0.18);
}

.hero-head {
  display: flex;
  flex-direction: column;
}

.hero-cap {
  font-size: 23rpx;
  opacity: 0.75;
  letter-spacing: 0.05em;
}

.hero-amount {
  font-size: 62rpx;
  font-weight: 600;
  letter-spacing: -0.03em;
  margin-top: 4rpx;
}

.hero-grid {
  display: flex;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
}

.hero-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.hg-cap {
  font-size: 21rpx;
  opacity: 0.7;
}

.hg-val {
  font-size: 27rpx;
  margin-top: 4rpx;
  font-weight: 500;
}

.compare-row {
  display: flex;
  margin-top: 16rpx;
}

.cmp-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-right: 14rpx;
  box-shadow: 0 8rpx 22rpx rgba(62, 52, 38, 0.04);
}

.cmp-card:last-child {
  margin-right: 0;
}

.cmp-cap {
  display: block;
  font-size: 21rpx;
  color: #A59D91;
}

.cmp-val {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 6rpx;
  color: #6E675D;
}

.cmp-val.up {
  color: #DE6B47;
}

.cmp-val.down {
  color: #2E8B6F;
}

.chart-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 26rpx 26rpx 20rpx;
  margin-top: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(62, 52, 38, 0.04);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
}

.card-more {
  font-size: 21rpx;
  color: #A59D91;
}

.mini-seg {
  display: flex;
  background: #F1ECE4;
  border-radius: 999rpx;
  padding: 4rpx;
}

.mini-item {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #8C857B;
}

.mini-item.on {
  background: #FFFFFF;
  color: #2F6F5E;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(62, 52, 38, 0.08);
}

.chart-sub {
  font-size: 22rpx;
  color: #A59D91;
  margin-top: 6rpx;
}

.donut-canvas {
  display: block;
  width: 360rpx;
  height: 360rpx;
  margin: 18rpx auto 4rpx;
}

.rank-list {
  margin-top: 8rpx;
}

.rank-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F3EEE6;
}

.rank-row:last-child {
  border-bottom: none;
}

.rank-icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

.rank-mid {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.rank-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rank-name {
  font-size: 26rpx;
  color: #2E2A25;
  font-weight: 500;
  max-width: 55%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-amt {
  font-size: 26rpx;
  font-weight: 600;
  color: #2E2A25;
}

.rank-track {
  height: 6rpx;
  border-radius: 99rpx;
  background: #F2EDE5;
  margin: 10rpx 0 6rpx;
  overflow: hidden;
}

.rank-fill {
  height: 100%;
  border-radius: 99rpx;
}

.rank-meta {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: #A59D91;
}

.rank-arrow {
  color: #C4BDB1;
  font-size: 26rpx;
  margin-left: 10rpx;
}

.rank-empty {
  text-align: center;
  color: #A59D91;
  font-size: 24rpx;
  padding: 36rpx 0 20rpx;
}

.trend-canvas {
  display: block;
  width: 100%;
  height: 270rpx;
  margin-top: 18rpx;
}

.share-entry {
  margin-top: 18rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 27rpx;
  color: #2F6F5E;
  box-shadow: 0 8rpx 22rpx rgba(62, 52, 38, 0.04);
}

.share-arrow {
  color: #B9B2A6;
}

.foot-note {
  text-align: center;
  color: #B3ABA0;
  font-size: 21rpx;
  margin-top: 30rpx;
}
