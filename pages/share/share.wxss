.share-page {
  min-height: 100vh;
  padding: 16rpx 26rpx 60rpx;
  background: #F7F5F0;
}

.month-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 0 22rpx;
}

.m-arrow {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #EFEAE2;
  color: #5A544B;
  font-size: 36rpx;
}

.m-label {
  font-size: 30rpx;
  font-weight: 600;
  margin: 0 20rpx;
  min-width: 200rpx;
  text-align: center;
}

.poster-wrap {
  border-radius: 26rpx;
  overflow: hidden;
  background: #FFFDF9;
  box-shadow: 0 14rpx 36rpx rgba(62, 52, 38, 0.1);
}

.poster-canvas {
  display: block;
  width: 100%;
  height: 1060rpx;
}

.share-actions {
  display: flex;
  margin-top: 30rpx;
}

.share-actions .btn-ghost {
  margin-right: 16rpx;
}

.save-btn {
  height: 84rpx;
  line-height: 84rpx;
}

.share-btn {
  margin-top: 18rpx;
  width: 100%;
}

.tip-card {
  margin-top: 28rpx;
  padding: 24rpx 26rpx;
  border-radius: 20rpx;
  background: #FFFDF9;
  border: 1rpx solid #EDE7DD;
}

.tip-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #4A453E;
}

.tip-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #9C958A;
}
