.cal-page {
  min-height: 100vh;
  padding: 18rpx 26rpx 60rpx;
  background: #F7F5F0;
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 4rpx 18rpx;
}

.nav {
  display: flex;
  align-items: center;
}

.nav-arrow {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #EFEAE2;
  color: #5A544B;
  font-size: 36rpx;
}

.nav-label {
  font-size: 34rpx;
  font-weight: 600;
  margin: 0 18rpx;
  min-width: 200rpx;
  text-align: center;
}

.today-btn {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #EAE3D8;
  font-size: 23rpx;
  color: #2F6F5E;
}

.month-strip {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(62, 52, 38, 0.04);
}

.ms-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.ms-item.small-item {
  flex: 0 0 auto;
  min-width: 150rpx;
  text-align: right;
}

.ms-cap {
  font-size: 21rpx;
  color: #9C958A;
}

.ms-val {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #2E2A25;
}

.ms-val.expense {
  color: #DE6B47;
}

.ms-val.income {
  color: #2E8B6F;
}

.cal-card {
  margin-top: 20rpx;
  background: #FFFFFF;
  border-radius: 26rpx;
  padding: 20rpx 14rpx 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(62, 52, 38, 0.04);
}

.week-row {
  display: flex;
  padding-bottom: 10rpx;
}

.week-cell {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #A59D91;
}

.days-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: 14.2857%;
  height: 94rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.day-cell.blank {
  visibility: hidden;
}

.day-num {
  font-size: 26rpx;
  color: #4A453E;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 50%;
  font-family: "DIN Alternate", "Bahnschrift", sans-serif;
}

.day-cell.today .day-num {
  color: #2F6F5E;
  font-weight: 600;
}

.day-cell.selected .day-num {
  background: #2F6F5E;
  color: #FFFFFF;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #DE6B47;
  margin-top: 3rpx;
}

.dot.income {
  background: #2E8B6F;
}

.day-cell.selected .dot {
  background: #FFFFFF;
  opacity: 0.85;
}

.legend {
  display: flex;
  align-items: center;
  padding: 14rpx 12rpx 0;
  border-top: 1rpx solid #F3EEE6;
  margin-top: 6rpx;
}

.lg-item {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
  font-size: 20rpx;
  color: #A59D91;
}

.lg-item .dot {
  margin: 0 8rpx 0 0;
}

.lg-days {
  margin-left: auto;
  font-size: 20rpx;
  color: #B3ABA0;
}

.day-panel {
  margin-top: 26rpx;
}

.dp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 12rpx;
}

.dp-date-box {
  display: flex;
  align-items: baseline;
}

.dp-date {
  font-size: 28rpx;
  font-weight: 600;
  color: #2E2A25;
}

.dp-week {
  font-size: 21rpx;
  color: #A59D91;
  margin-left: 10rpx;
}

.dp-sums {
  display: flex;
  align-items: center;
}

.dp-sum {
  font-size: 21rpx;
  margin-left: 14rpx;
  color: #9C9489;
}

.dp-sum.expense {
  color: #DE6B47;
}

.dp-sum.income {
  color: #2E8B6F;
}

.dp-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 0 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(62, 52, 38, 0.04);
}

.bill-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F3EEE6;
}

.bill-row:last-child {
  border-bottom: none;
}

.bill-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}

.bill-main {
  flex: 1;
  min-width: 0;
  padding: 0 18rpx;
}

.bill-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2E2A25;
  display: flex;
  align-items: center;
}

.bill-attach {
  font-size: 20rpx;
  margin-left: 8rpx;
  opacity: 0.6;
}

.bill-sub {
  font-size: 22rpx;
  color: #A59D91;
  margin-top: 4rpx;
  max-width: 100%;
}

.bill-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.bill-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: #2E2A25;
}

.bill-amount.income {
  color: #2E8B6F;
}

.bill-amount.transfer {
  color: #7C8A84;
  font-weight: 500;
}

.bill-time {
  font-size: 19rpx;
  color: #B9B2A6;
  margin-top: 4rpx;
}

.day-empty {
  background: #FFFDF9;
  border: 1rpx solid #EDE7DD;
  border-radius: 22rpx;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.de-title {
  font-size: 25rpx;
  color: #4A453E;
}

.de-desc {
  font-size: 21rpx;
  color: #A59D91;
  margin-top: 6rpx;
}

.de-btn {
  margin-top: 20rpx;
  height: 64rpx;
  padding: 0 34rpx;
}
