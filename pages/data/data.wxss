.data-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 60rpx;
  background: #F7F5F0;
}

.storage-card {
  background: #FFFFFF;
  border-radius: 26rpx;
  padding: 26rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(62, 52, 38, 0.04);
}

.storage-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #2E2A25;
}

.storage-val {
  font-size: 23rpx;
  color: #6E675D;
  font-family: "DIN Alternate", sans-serif;
}

.storage-track {
  height: 10rpx;
  border-radius: 99rpx;
  background: #F2EDE5;
  margin-top: 16rpx;
  overflow: hidden;
}

.storage-fill {
  height: 100%;
  border-radius: 99rpx;
  background: #B7CCC2;
}

.storage-fill.warn {
  background: #DE6B47;
}

.storage-meta {
  font-size: 21rpx;
  color: #A59D91;
  margin-top: 10rpx;
}

.storage-warn {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #B9512E;
  background: #FFF3ED;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  line-height: 1.6;
}

.card {
  background: #FFFFFF;
  border-radius: 26rpx;
  padding: 0 24rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(62, 52, 38, 0.04);
}

.card .form-row {
  padding-left: 4rpx;
  padding-right: 4rpx;
}

.card-desc {
  font-size: 22rpx;
  color: #9C9489;
  line-height: 1.7;
  padding: 4rpx 4rpx 18rpx;
}

.export-btn {
  height: 82rpx;
  line-height: 82rpx;
}

.backup-row {
  display: flex;
}

.backup-file-btn {
  width: 210rpx;
  height: 82rpx;
  line-height: 82rpx;
  margin-left: 14rpx;
  flex-shrink: 0;
  font-size: 26rpx;
}

.backup-info {
  margin-top: 14rpx;
  font-size: 21rpx;
  color: #2F6F5E;
  background: #F2F8F5;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
}

.backup-divider {
  margin: 24rpx 4rpx 20rpx;
}

.restore-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #4A453E;
  padding: 0 4rpx 12rpx;
}

.restore-input {
  width: 100%;
  height: 180rpx;
  background: #FAF7F1;
  border: 1rpx solid #EDE7DD;
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.restore-btn {
  margin-top: 16rpx;
  height: 82rpx;
  line-height: 82rpx;
}

.danger-card {
  background: #FFF9F6;
  border: 1rpx solid #F1D8CE;
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
}

.danger-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #A8452A;
}

.danger-desc {
  font-size: 22rpx;
  color: #9A6A5B;
  line-height: 1.7;
  margin: 8rpx 0 20rpx;
}

.foot-tip {
  margin-top: 28rpx;
  padding: 0 8rpx;
}

.foot-tip-strong {
  display: block;
  font-size: 23rpx;
  font-weight: 600;
  color: #6E675D;
}

.foot-tip-text {
  display: block;
  font-size: 21rpx;
  color: #A59D91;
  line-height: 1.75;
  margin-top: 6rpx;
}
